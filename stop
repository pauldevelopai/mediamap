#!/bin/bash

# AIMAP Stop Script
echo "🛑 Stopping AIMAP Application..."

# Stop the Flask app
pkill -f "python -m backend.app"

# Wait a moment
sleep 2

# Check if it's still running
if pgrep -f "python -m backend.app" > /dev/null; then
    echo "⚠️  Force stopping remaining processes..."
    pkill -9 -f "python -m backend.app"
fi

echo "✅ AIMAP Application stopped"










