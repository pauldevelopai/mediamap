# Organization Discovery API Keys
# Copy this file to .env and add your actual API keys

# News API (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# LinkedIn API (requires LinkedIn Developer account)
LINKEDIN_API_KEY=your_linkedin_api_key_here

# Twitter API (requires Twitter Developer account)
TWITTER_API_KEY=your_twitter_api_key_here

# Crunchbase API (requires Crunchbase Pro account)
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# OpenAI API (for AI-powered analysis)
OPENAI_API_KEY=your_openai_api_key_here


