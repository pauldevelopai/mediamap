# DataSafe Environment Configuration
# Copy this file to .env and add these variables

# === Core Configuration ===
# Keep non-finance related threats during testing (set to true for full data)
DS_KEEP_NON_FINANCE=true

# Database path for threat intelligence storage
DATASAFE_DB_PATH=datasafe.db

# === ML Model Configuration ===
# Hugging Face models (defaults provided, customize if needed)
DS_HF_ZERO_SHOT_MODEL=facebook/bart-large-mnli
DS_HF_SUMMARY_MODEL=facebook/bart-large-cnn
DS_HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Classification confidence thresholds
DS_ZERO_SHOT_CONF=0.55
DS_DEDUP_SIM=0.9

# === External API Keys (Optional) ===
# PhishTank API (for enhanced phishing data)
# Get your key from: https://www.phishtank.com/api_info.php
# PHISHTANK_CSV_URL=https://data.phishtank.com/data/YOUR_KEY/online-valid.csv

# NVD API Key (for better rate limits on CVE data)
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your_nvd_api_key_here

# === Search Queries ===
# Customize NVD search terms (finance-focused by default)
NVD_QUERY=bank OR payment OR visa OR mastercard OR financial OR fintech

# RSS feeds for additional threat intelligence
# DS_RSS=https://www.itweb.co.za/rss/categories/security
# DS_RSS=https://feeds.feedburner.com/eset/blog
